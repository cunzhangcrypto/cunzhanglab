---
import AINodeNetwork from "../React/AINodeNetwork.tsx";
import LogoWall from "../components/logoWall.astro";
---

<section class="text-[var(--white)] mt-12 md:mt-0 min-h-screen flex items-center" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-24 pb-14 w-full">
    <div class="text-left space-y-6 fade-in visible">
      <p class="text-sm md:text-base text-[var(--sec)] font-medium tracking-[0.2em] uppercase">
        Cunzhang Lab
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-start space-y-6 lg:space-y-0 lg:space-x-12"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-7xl font-semibold text-pretty leading-none tracking-tight text-glow"
        >
          村长实验室
        </h1>
        <div class="space-y-4">
          <p class="text-md md:text-xl text-[var(--white-icon)] leading-relaxed max-w-lg">
            探索 AI 工具、开源项目与互联网技术实践
          </p>
          <p class="text-sm md:text-base text-[var(--white-icon)]/60 leading-relaxed max-w-lg">
            记录真实测试、部署过程和数字生产力探索
          </p>
        </div>
      </div>
      <div class="flex justify-start gap-3 pt-4 md:pt-8">
        <a
          target="_blank"
          href="https://github.com/cunzhangcrypto"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:border-[var(--sec)] hover:shadow-[0_0_20px_rgba(74,158,255,0.1)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7">
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="https://cunzhangblog.com"
          aria-label="博客"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:border-[var(--sec)] hover:shadow-[0_0_20px_rgba(74,158,255,0.1)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7">
            <path d="M20 22H4C3.44772 22 3 21.5523 3 21V3C3 2.44772 3.44772 2 4 2H20C20.5523 2 21 2.44772 21 3V21C21 21.5523 20.5523 22 20 22ZM19 20V4H5V20H19ZM7 6H11V10H7V6ZM7 12H17V14H7V12ZM7 16H17V18H7V16ZM13 7H17V9H13V7Z"></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="https://youtube.com/@cunzhanglab"
          aria-label="视频频道"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:border-[var(--sec)] hover:shadow-[0_0_20px_rgba(74,158,255,0.1)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7">
            <path d="M19.606 6.995c-.076-.298-.292-.523-.539-.592C18.63 6.28 16.5 6 12 6s-6.628.28-7.069.403c-.244.068-.46.293-.537.592C4.285 7.585 4 9.21 4 12s.285 4.415.394 5.005c.076.298.292.523.539.592C5.373 17.72 7.5 18 12 18s6.628-.28 7.069-.403c.244-.068.46-.293.537-.592C19.715 16.415 20 14.79 20 12s-.285-4.415-.394-5.005zM9.5 9.828L15 12l-5.5 2.172V9.828z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="pt-8 md:pt-12 border-t border-[#ffffff08] fade-in visible">
      <LogoWall />
    </div>

    <div class="w-full pt-4 md:pt-8 fade-in visible">
      <div class="w-full h-[280px] md:h-[360px] rounded-2xl overflow-hidden border border-[#ffffff08]">
        <AINodeNetwork client:load />
      </div>
    </div>
  </div>
</section>
