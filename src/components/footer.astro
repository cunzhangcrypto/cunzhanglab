---

const currentYear = new Date().getFullYear();
---

<footer class="w-full py-12 fade-in">
  <div class="h-px w-full bg-[linear-gradient(90deg,transparent,rgba(255,134,89,0.5),rgba(139,92,246,0.5),rgba(21,85,217,0.5),transparent)]"></div>
  <div class="max-w-5xl mx-auto mt-10">
    <div class="flex flex-col items-center gap-8">
      <div class="flex space-x-6 sm:space-x-8">
        {
          [
            {
              href: "https://github.com/cunzhangcrypto",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>',
              label: "GitHub",
            },
            {
              href: "https://youtube.com/@cunzhanglab",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M19.606 6.995c-.076-.298-.292-.523-.539-.592C18.63 6.28 16.5 6 12 6s-6.628.28-7.069.403c-.244.068-.46.293-.537.592C4.285 7.585 4 9.21 4 12s.285 4.415.394 5.005c.076.298.292.523.539.592C5.373 17.72 7.5 18 12 18s6.628-.28 7.069-.403c.244-.068.46-.293.537-.592C19.715 16.415 20 14.79 20 12s-.285-4.415-.394-5.005zM9.5 9.828L15 12l-5.5 2.172V9.828z"></path></svg>',
              label: "YouTube",
            },
            {
              href: "https://space.bilibili.com/1224034462",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.68h4.694l2.666-2.587c.267-.249.573-.373.92-.373.347 0 .662.128.929.382.267.254.392.56.374.92-.018.36-.142.666-.374.92l-1.175 1.12.026-.027zM5.333 16.44h13.334v-8.4H5.333v8.4zm2.4-6.453c-.373 0-.693.126-.96.378-.267.253-.4.56-.4.92l.027.92c.018.36.142.666.373.92.231.253.547.38.947.38h.026c.373 0 .693-.127.96-.38.267-.253.4-.56.4-.92v-.92c0-.36-.133-.667-.4-.92-.267-.252-.587-.378-.96-.378h-.013zm8.534 0c-.373 0-.693.126-.96.378-.267.253-.4.56-.4.92l.027.92c.018.36.142.666.373.92.231.253.547.38.947.38h.026c.373 0 .693-.127.96-.38.267-.253.4-.56.4-.92v-.92c0-.36-.133-.667-.4-.92-.267-.252-.587-.378-.96-.378h-.013z"/></svg>',
              label: "Bilibili",
            },
            {
              href: "https://twitter.com/web3cun",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
              label: "X",
            },
            {
              href: "https://cunzhangblog.com",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M20 22H4C3.44772 22 3 21.5523 3 21V3C3 2.44772 3.44772 2 4 2H20C20.5523 2 21 2.44772 21 3V21C21 21.5523 20.5523 22 20 22ZM19 20V4H5V20H19ZM7 6H11V10H7V6ZM7 12H17V14H7V12ZM7 16H17V18H7V16ZM13 7H17V9H13V7Z"></path></svg>',
              label: "博客",
            },
          ].map((link) => (
            <a
              href={link.href}
              target="_blank"
              class="flex flex-col items-center group"
              aria-label={link.label}
            >
              <div class="text-[var(--white-icon)] hover:text-[var(--sec)] transition duration-300 ease-in-out">
                <div set:html={link.icon} />
              </div>
            </a>
          ))
        }
      </div>

      <div class="text-center space-y-1">
        <p class="text-sm text-[var(--white)]">村长实验室</p>
        <p class="text-xs text-[var(--white-icon)]">Cunzhang Lab</p>
        <p class="text-xs text-[var(--white-icon)]/80 mt-3">站长 · Web3村长</p>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-[var(--border)]">
      <p class="text-center text-xs text-[var(--white-icon)]/70">
        Copyright © {currentYear} Web3村长. All rights reserved.
      </p>
    </div>
  </div>
</footer>
