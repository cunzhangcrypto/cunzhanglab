---

interface LabCategory {
  emoji: string;
  title: string;
  description: string;
}

const categories: LabCategory[] = [
  {
    emoji: "🤖",
    title: "AI 实验",
    description: "测试各种 AI 工具、模型和自动化方案，记录实测效果与对比。",
  },
  {
    emoji: "☁",
    title: "云服务实验",
    description: "Cloudflare、Vercel、服务器部署等云服务的实际应用和踩坑记录。",
  },
  {
    emoji: "🐳",
    title: "自托管实验",
    description: "Docker 部署、开源服务自托管，探索脱离第三方服务的可能性。",
  },
  {
    emoji: "🔐",
    title: "安全实验",
    description: "隐私工具、账号安全实践，提升数字生活的安全性和可控性。",
  },
];
---

<section id="lab" class="py-16 md:py-24 border-t border-[var(--border)] fade-in">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 font-medium shiny-sec">Lab</h2>
    <h3 class="text-3xl md:text-4xl font-semibold text-[var(--white)] mb-8">
      实验记录
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        categories.map((cat) => (
          <div class="bg-white border border-[#eceef1] rounded-2xl p-6 md:p-8 shadow-[0_8px_32px_rgba(15,23,42,0.06)] hover:border-[var(--sec)]/20 hover:-translate-y-1 transition-all duration-300 card-glow">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-[#ff8659] via-[#8b5cf6] to-[#2563eb] text-xl mb-4 shadow-md shadow-[#8b5cf6]/20 ring-1 ring-black/5">{cat.emoji}</div>
            <h4 class="text-xl font-semibold text-[var(--white)] mb-2">{cat.title}</h4>
            <p class="text-sm text-[var(--white-icon)] leading-relaxed">{cat.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
