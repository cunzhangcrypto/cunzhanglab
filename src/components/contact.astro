---

<section id="contact" class="w-full py-16 md:py-24 border-t border-[#ffffff08] fade-in">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 font-medium shiny-sec">Contact</h2>
    <h3 class="text-3xl md:text-4xl font-semibold text-[var(--white)] mb-8">
      联系村长
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div>
        <p class="text-[var(--white-icon)] leading-relaxed mb-6">
          如果你有项目合作、技术交流或任何想法，欢迎通过以下方式联系我。
        </p>
        <div class="flex flex-wrap gap-3">
          {
            contactItems.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="flex flex-col items-center group"
              >
                <div class="text-[var(--white-icon)] hover:text-[var(--sec)] hover:border-[var(--sec)]/30 transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]">
                  <fragment set:html={item.icon} />
                </div>
                <span class="text-xs text-[var(--white-icon)] mt-1.5">{item.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="bg-[#0d0d0d] border border-[#ffffff08] rounded-2xl p-6 md:p-8 space-y-4 card-glow">
        <div>
          <span class="text-xs text-[var(--white-icon)]/60 block mb-1">Email</span>
          <a href="mailto:service@czlab.dev" class="text-sm text-[var(--sec)] hover:text-[var(--accent)] transition-colors">
            service@czlab.dev
          </a>
        </div>
        <div>
          <span class="text-xs text-[var(--white-icon)]/60 block mb-1">Telegram</span>
          <a href="https://t.me/cunzhanglab" target="_blank" class="text-sm text-[var(--sec)] hover:text-[var(--accent)] transition-colors">
            @cunzhanglab
          </a>
        </div>
        <div>
          <span class="text-xs text-[var(--white-icon)]/60 block mb-1">X</span>
          <a href="https://twitter.com/web3cun" target="_blank" class="text-sm text-[var(--sec)] hover:text-[var(--accent)] transition-colors">
            @web3cun
          </a>
        </div>
        <div>
          <span class="text-xs text-[var(--white-icon)]/60 block mb-1">GitHub</span>
          <a href="https://github.com/cunzhangcrypto" target="_blank" class="text-sm text-[var(--sec)] hover:text-[var(--accent)] transition-colors">
            github.com/cunzhangcrypto
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
