---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TQS4BPYE0F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TQS4BPYE0F');
    </script>
    <meta charset="UTF-8" />
    <title>{title} | Cunzhang Lab</title>
    <meta
      name="description"
      content="探索 AI 工具、开源项目与互联网技术实践，记录真实测试、部署过程和数字生产力探索。"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://czlab.dev/" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:title" content="村长实验室 | Cunzhang Lab" />
    <meta
      property="og:description"
      content="探索 AI 工具、开源项目与互联网技术实践，记录真实测试、部署过程和数字生产力探索。"
    />
    <meta
      property="og:image"
      content="https://czlab.dev/og.image.png"
    />
    <meta property="og:url" content="https://czlab.dev" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="村长实验室 | Cunzhang Lab" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Web3村长",
        "alternateName": "Cunzhang",
        "url": "https://czlab.dev",
        "image": "https://czlab.dev/og.image.png",
        "sameAs": [
          "https://github.com/cunzhangcrypto",
          "https://cunzhangblog.com",
          "https://cunzhangai.com",
          "https://youtube.com/@cunzhanglab",
          "https://twitter.com/web3cun",
          "https://space.bilibili.com/1224034462"
        ],
        "jobTitle": "技术内容创作者",
        "description": "中文互联网技术内容创作者，专注 AI 工具、开源项目与数字生产力探索。"
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9 relative">
    <!-- 柔和极光氛围背景（橙 → 紫 → 蓝） -->
    <div class="fixed inset-0 pointer-events-none z-0" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(1100px_560px_at_12%_-5%,rgba(255,138,91,0.22)_0%,transparent_62%),radial-gradient(1000px_520px_at_88%_8%,rgba(37,99,235,0.16)_0%,transparent_62%),radial-gradient(900px_600px_at_50%_95%,rgba(139,92,246,0.12)_0%,transparent_55%)]"></div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #fbfbfd;
    --sec: #6d28d9;
    --accent: #1555d9;
    --glow: rgba(109, 40, 217, 0.12);
    --white: #0f172a;
    --white-icon: #6b7280;
    --white-icon-tr: rgba(15, 23, 42, 0.06);
    --border: rgba(15, 23, 42, 0.06);
    --component-bg: rgba(255, 255, 255, 0.72);
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: #ffffff;
  }

  html {
    scroll-behavior: smooth;
  }

  /* 全局渐入动画 */
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 发光文字 */
  .text-glow {
    text-shadow: 0 0 40px rgba(139, 92, 246, 0.22),
                 0 0 80px rgba(139, 92, 246, 0.1);
  }

  /* 渐变眉标文字 */
  .shiny-sec {
    background: linear-gradient(90deg, #ff8659, #8b5cf6, #1555d9);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* 发光边框卡片 */
  .card-glow {
    position: relative;
    transition: all 0.4s ease;
  }

  .card-glow::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,138,91,0), rgba(255,138,91,0.45), rgba(139,92,246,0.45), rgba(37,99,235,0.45), rgba(37,99,235,0));
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    padding: 1px;
  }

  .card-glow:hover::before {
    opacity: 1;
  }

  .card-glow:hover {
    border-color: rgba(139, 92, 246, 0.28) !important;
    box-shadow: 0 10px 36px rgba(139, 92, 246, 0.14);
  }

  /* 渐变色分隔 */
  .section-divider {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.15), transparent);
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 12px;
  }

  ::-webkit-scrollbar-track {
    background: #eef0f4;
  }

  ::-webkit-scrollbar-thumb {
    background: #c9ced6;
    border-radius: 10px;
    border: 2px solid #eef0f4;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #a7aeba;
  }

  /* Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: #c9ced6 #eef0f4;
  }
</style>
